# ---------------------------------------------------------------------------
# RentMate server environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# URLs (used for CORS + links sent in emails/messages)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# --- Required from Milestone 3 (database) -----------------------------------
# PostgreSQL connection string used by Prisma
DATABASE_URL=

# --- Required from Milestone 4 (authentication) -----------------------------
# Must be at least 32 characters - generate with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d
# Set to "true" in production so the auth cookie is only sent over HTTPS
COOKIE_SECURE=false

# --- Required from Milestone 15 (image uploads) -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional tuning --------------------------------------------------------
# Rate limiting: window in milliseconds and max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
