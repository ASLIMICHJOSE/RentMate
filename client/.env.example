# Client environment variables (Vite exposes only VITE_* to the browser)
# Do not put secrets here - anything in this file ships to the user's browser.

# Base URL the browser uses for API calls.
# "/api" keeps requests same-origin and relies on the dev proxy / production rewrite.
VITE_API_URL=/api

# Where the Vite dev server proxies /api and /socket.io (server must run here).
VITE_API_PROXY_TARGET=http://localhost:5000
